# Copy to .env (never commit .env). Read by scripts/_common.sh.
CONTACT_EMAIL=you@example.com     # goes in the User-Agent sent to FDA; use a real address you read
GCS_BUCKET=                       # shared results bucket (optional), e.g. coms4705-predx-data
HF_TOKEN=                         # Hugging Face token, only for the gated EmbeddingGemma tokenizer in the audit
